@model IEnumerable<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Upcoming Race Events</h2>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">No events scheduled right now. Check back soon!</div> 
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(item.BannerUrl))
                    {
                        <img src="@item.BannerUrl" class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white text-center py-5">
                            <span>No Banner</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title font-weight-bold">@item.Title</h5>
                        <p class="card-text text-muted mb-2">
                            📍 @item.Location<br />
                            📅 @item.EventDate.ToString("MMM dd, yyyy")
                        </p>
                        <p class="card-text">@(item.Description.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description)</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        }
    }
</div>
